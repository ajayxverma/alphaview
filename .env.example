# Generated secrets are filled in automatically by ./start.sh or start.bat on first run.
JWT_SECRET=
ENCRYPTION_KEY=

# Google OAuth (GA4 + Search Console). Redirect URI: http://localhost:8000/connections/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional server-wide LLM fallback. Users normally add their own provider keys on the "AI Models" page.
# Examples: gpt-4o-mini | anthropic/claude-3-5-sonnet-20241022 | groq/llama-3.3-70b-versatile
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Set true to let users point at http:// or private-network LLM servers (e.g. local Ollama). Single-user only.
ALLOW_PRIVATE_LLM_ENDPOINTS=false

# Host ports for infra (non-default to avoid clashing with locally installed Postgres/Redis).
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
CLICKHOUSE_HOST_PORT=58123
TEMPORAL_HOST_PORT=57233

# Only used when running a service natively against the Docker infra (make dev-*).
DATABASE_URL=postgresql+asyncpg://alphaview:alphaview@localhost:55432/alphaview
REDIS_URL=redis://localhost:56379/0
CLICKHOUSE_PORT=58123
CLICKHOUSE_PASSWORD=alphaview
TEMPORAL_HOST=localhost:57233
